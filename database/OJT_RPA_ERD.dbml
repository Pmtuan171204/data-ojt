Table "OJTAlertTargets" {
  "TargetID" "bigint" [not null, increment]
  "StudentID" "integer" [not null]
  "OJTSemesterID" "integer" [not null]
  "IsActive" "boolean" [not null, note: 'PostgreSQL default: true']
  "Source" "text" [not null]
  "ConfirmedBy" "integer" [not null]
  "ConfirmedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("StudentID", "OJTSemesterID") [unique, name: 'OJTAlertTargets_StudentID_OJTSemesterID_key']
    ("TargetID", "OJTSemesterID") [unique, name: 'OJTAlertTargets_TargetID_OJTSemesterID_key']
    ("TargetID") [pk, name: 'OJTAlertTargets_pkey']
  }
  Note: 'Danh sách sinh viên cần theo dõi theo kỳ\nCHECK ("Source" = ANY (ARRAY[\'ACADEMIC_PLAN\'::text, \'IMPORT\'::text, \'STAFF\'::text]))'
}

Table "OJTAlertRules" {
  "RuleID" "bigint" [not null, increment]
  "RuleCode" "text" [not null]
  "Version" "integer" [not null]
  "Name" "text" [not null]
  "RuleType" "text" [not null]
  "Scope" "text" [not null]
  "Anchor" "text" [not null]
  "LeadDays" "integer" [not null, note: 'PostgreSQL default: 7']
  "GraceDays" "integer" [not null, note: 'PostgreSQL default: 0']
  "Severity" "text" [not null, note: 'PostgreSQL default: \'WARNING\'::text']
  "CooldownHours" "integer" [not null, note: 'PostgreSQL default: 24']
  "Parameters" "jsonb" [not null, note: 'PostgreSQL default: \'{}\'::jsonb']
  "IsEnabled" "boolean" [not null, note: 'PostgreSQL default: false']
  "ApprovedBy" "integer" [null]
  "ApprovedAt" "timestamp with time zone" [null]
  "CreatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("RuleCode", "Version") [unique, name: 'OJTAlertRules_RuleCode_Version_key']
    ("RuleID", "Scope") [unique, name: 'OJTAlertRules_RuleID_Scope_key']
    ("RuleID") [pk, name: 'OJTAlertRules_pkey']
  }
  Note: 'Quy tắc cảnh báo có phiên bản\nCHECK ("Anchor" = ANY (ARRAY[\'REG_END\'::text, \'OJT_START\'::text, \'TASK_DUE\'::text]))\nCHECK ("CooldownHours" >= 1)\nCHECK ("GraceDays" >= 0)\nCHECK ("LeadDays" >= 0)\nCHECK (jsonb_typeof("Parameters") = \'object\'::text)\nCHECK ("RuleType" = ANY (ARRAY[\'ELIGIBILITY_NOT_MET\'::text, \'REGISTRATION_MISSING\'::text, \'PLACEMENT_MISSING\'::text, \'TASK_OVERDUE\'::text]))\nCHECK ("Scope" = ANY (ARRAY[\'STUDENT\'::text, \'TASK\'::text]))\nCHECK ("Severity" = ANY (ARRAY[\'INFO\'::text, \'WARNING\'::text, \'CRITICAL\'::text]))\nCHECK ("Version" > 0)\nCHECK (NOT "IsEnabled" OR "ApprovedBy" IS NOT NULL AND "ApprovedAt" IS NOT NULL)\nCHECK ("RuleType" = \'TASK_OVERDUE\'::text AND "Scope" = \'TASK\'::text AND "Anchor" = \'TASK_DUE\'::text AND "LeadDays" = 0 OR "RuleType" <> \'TASK_OVERDUE\'::text AND "Scope" = \'STUDENT\'::text AND ("Anchor" = ANY (ARRAY[\'REG_END\'::text, \'OJT_START\'::text])))\nCREATE UNIQUE INDEX "UQ_EnabledAlertRule" ON public."OJTAlertRules" USING btree ("RuleCode") WHERE "IsEnabled"'
}

Table "OJTAlertCheckRuns" {
  "RunID" "bigint" [not null, increment]
  "IdempotencyKey" "text" [not null]
  "OJTSemesterID" "integer" [not null]
  "AsOf" "timestamp with time zone" [not null]
  "EngineVersion" "text" [not null]
  "TriggeredBy" "integer" [null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'PENDING\'::text']
  "StartedAt" "timestamp with time zone" [null]
  "CompletedAt" "timestamp with time zone" [null]
  "ErrorCode" "text" [null]
  indexes {
