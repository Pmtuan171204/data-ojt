Table "OJTEnterpriseImportBatches" {
  "BatchID" "bigint" [not null, increment]
  "IdempotencyKey" "text" [not null]
  "SourceName" "text" [not null]
  "SourceObjectPath" "text" [null]
  "ImportedBy" "integer" [not null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'PENDING\'::text']
  "CreatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  "CompletedAt" "timestamp with time zone" [null]
  indexes {
    ("IdempotencyKey") [unique, name: 'OJTEnterpriseImportBatches_IdempotencyKey_key']
    ("BatchID") [pk, name: 'OJTEnterpriseImportBatches_pkey']
  }
  Note: 'Đợt import doanh nghiệp\nCHECK ("Status" = ANY (ARRAY[\'PENDING\'::text, \'PROCESSING\'::text, \'COMPLETED\'::text, \'PARTIAL\'::text, \'FAILED\'::text]))'
}

Table "OJTEnterpriseImportRows" {
  "ImportRowID" "bigint" [not null, increment]
  "BatchID" "bigint" [not null]
  "RowNumber" "integer" [not null]
  "SourceRecordKey" "text" [null]
  "RawData" "jsonb" [not null]
  "NormalizedData" "jsonb" [null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'PENDING\'::text']
  "ValidationErrors" "jsonb" [not null, note: 'PostgreSQL default: \'[]\'::jsonb']
  "EnterpriseID" "integer" [null]
  indexes {
    ("BatchID", "RowNumber") [unique, name: 'OJTEnterpriseImportRows_BatchID_RowNumber_key']
    ("ImportRowID") [pk, name: 'OJTEnterpriseImportRows_pkey']
  }
  Note: 'Dòng dữ liệu import và lỗi chuẩn hóa\nCHECK (jsonb_typeof("NormalizedData") = \'object\'::text)\nCHECK (jsonb_typeof("RawData") = \'object\'::text)\nCHECK ("RowNumber" > 0)\nCHECK ("Status" = ANY (ARRAY[\'PENDING\'::text, \'VALID\'::text, \'IMPORTED\'::text, \'REJECTED\'::text]))\nCHECK (jsonb_typeof("ValidationErrors") = \'array\'::text)\nCHECK ("Status" <> \'IMPORTED\'::text OR "EnterpriseID" IS NOT NULL)'
}

