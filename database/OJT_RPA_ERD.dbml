Table "OJTMatchingProfiles" {
  "ProfileID" "bigint" [not null, increment]
  "ProfileType" "text" [not null]
  "EnterpriseID" "integer" [not null]
  "OJTSemesterID" "integer" [not null]
  "PositionID" "integer" [null]
  "ImportRowID" "bigint" [null]
  "CompanyOJTDescription" "text" [null]
  "CompanyCapacity" "integer" [null]
  "CompanyRemainingSlots" "integer" [null]
  "CompanyLocation" "text" [null]
  "CompanyWorkMode" "text" [null]
  "MinGPA" "numeric(4,2)" [null]
  "GPAScale" "numeric(4,2)" [null]
  "LanguageRequirements" "jsonb" [not null, note: 'PostgreSQL default: \'[]\'::jsonb']
  "OtherHardRequirements" "jsonb" [not null, note: 'PostgreSQL default: \'{}\'::jsonb']
  "MajorPolicy" "text" [not null, note: 'PostgreSQL default: \'REVIEW_REQUIRED\'::text']
  "DeadlineAt" "timestamp with time zone" [null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'DRAFT\'::text']
  "ReviewedBy" "integer" [null]
  "ReviewedAt" "timestamp with time zone" [null]
  "UpdatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("PositionID") [unique, name: 'OJTMatchingProfiles_PositionID_key']
    ("ProfileID", "OJTSemesterID") [unique, name: 'OJTMatchingProfiles_ProfileID_OJTSemesterID_key']
    ("ProfileID") [pk, name: 'OJTMatchingProfiles_pkey']
  }
  Note: 'Hồ sơ matching vị trí có JD hoặc doanh nghiệp không JD\nCHECK ("CompanyCapacity" >= 0)\nCHECK ("CompanyWorkMode" = ANY (ARRAY[\'ONSITE\'::text, \'REMOTE\'::text, \'HYBRID\'::text]))\nCHECK ("GPAScale" = ANY (ARRAY[4::numeric, 10::numeric]))\nCHECK (jsonb_typeof("LanguageRequirements") = \'array\'::text)\nCHECK ("MajorPolicy" = ANY (ARRAY[\'ANY\'::text, \'ALLOW_LIST\'::text, \'REVIEW_REQUIRED\'::text]))\nCHECK (jsonb_typeof("OtherHardRequirements") = \'object\'::text)\nCHECK ("ProfileType" = ANY (ARRAY[\'POSITION\'::text, \'ENTERPRISE_OJT\'::text]))\nCHECK ("Status" = ANY (ARRAY[\'DRAFT\'::text, \'PUBLISHED\'::text, \'CLOSED\'::text, \'ARCHIVED\'::text]))\nCHECK ("CompanyRemainingSlots" >= 0 AND "CompanyRemainingSlots" <= "CompanyCapacity")\nCHECK ("MinGPA" >= 0::numeric AND "MinGPA" <= "GPAScale")\nCHECK (("MinGPA" IS NULL) = ("GPAScale" IS NULL))\nCHECK ("ProfileType" = \'POSITION\'::text AND "PositionID" IS NOT NULL AND "CompanyCapacity" IS NULL AND "CompanyRemainingSlots" IS NULL AND "CompanyOJTDescription" IS NULL AND "CompanyLocation" IS NULL AND "CompanyWorkMode" IS NULL OR "ProfileType" = \'ENTERPRISE_OJT\'::text AND "PositionID" IS NULL AND length(btrim("CompanyOJTDescription")) > 0 AND "CompanyOJTDescription" IS NOT NULL AND "CompanyCapacity" IS NOT NULL AND "CompanyRemainingSlots" IS NOT NULL)\nCHECK ("Status" <> \'PUBLISHED\'::text OR "ReviewedBy" IS NOT NULL AND "ReviewedAt" IS NOT NULL AND "MajorPolicy" <> \'REVIEW_REQUIRED\'::text)\nCREATE UNIQUE INDEX "UQ_CompanyOJT_Semester" ON public."OJTMatchingProfiles" USING btree ("EnterpriseID", "OJTSemesterID") WHERE ("ProfileType" = \'ENTERPRISE_OJT\'::text)'
}

