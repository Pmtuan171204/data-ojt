    ("RunID", "OJTSemesterID") [unique, name: 'OJTAlertCheckRuns_RunID_OJTSemesterID_key']
    ("RunID") [pk, name: 'OJTAlertCheckRuns_pkey']
  }
  Note: 'Lần chạy kiểm tra cảnh báo\nCHECK ("Status" = ANY (ARRAY[\'PENDING\'::text, \'RUNNING\'::text, \'SUCCEEDED\'::text, \'FAILED\'::text]))\nCHECK (("Status" <> ALL (ARRAY[\'SUCCEEDED\'::text, \'FAILED\'::text])) OR "CompletedAt" IS NOT NULL)'
}

Table "OJTAlertEvaluations" {
  "EvaluationID" "bigint" [not null, increment]
  "RunID" "bigint" [not null]
  "TargetID" "bigint" [not null]
  "OJTSemesterID" "integer" [not null]
  "RuleID" "bigint" [not null]
  "Scope" "text" [not null]
  "TaskID" "integer" [null]
  "ScopeKey" "text" [null, note: 'PostgreSQL generated stored expression: \nCASE\n    WHEN ("TaskID" IS NULL) THEN \'STUDENT\'::text\n    ELSE (\'TASK:\'::text || ("TaskID")::text)\nEND']
  "Outcome" "text" [not null]
  "ReasonCode" "text" [not null]
  "Evidence" "jsonb" [not null]
  "RuleSnapshot" "jsonb" [not null]
  "EvaluatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("EvaluationID", "TargetID", "RuleID", "ScopeKey", "Outcome") [unique, name: 'OJTAlertEvaluations_EvaluationID_TargetID_RuleID_ScopeKey_O_key']
    ("RunID", "TargetID", "RuleID", "ScopeKey") [unique, name: 'OJTAlertEvaluations_RunID_TargetID_RuleID_ScopeKey_key']
    ("EvaluationID") [pk, name: 'OJTAlertEvaluations_pkey']
  }
  Note: 'Kết quả đánh giá điều kiện theo đối tượng\nCHECK (jsonb_typeof("Evidence") = \'object\'::text)\nCHECK ("Outcome" = ANY (ARRAY[\'TRIGGERED\'::text, \'CLEAR\'::text, \'UNKNOWN\'::text, \'NOT_APPLICABLE\'::text]))\nCHECK (jsonb_typeof("RuleSnapshot") = \'object\'::text)\nCHECK ("Scope" = \'STUDENT\'::text AND "TaskID" IS NULL OR "Scope" = \'TASK\'::text AND "TaskID" IS NOT NULL)'
}

Table "OJTAlerts" {
  "AlertID" "bigint" [not null, increment]
  "TargetID" "bigint" [not null]
  "RuleID" "bigint" [not null]
  "ScopeKey" "text" [not null]
  "TriggerEvaluationID" "bigint" [not null]
  "TriggerOutcome" "text" [not null, note: 'PostgreSQL default: \'TRIGGERED\'::text']
  "Severity" "text" [not null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'OPEN\'::text']
  "Title" "text" [not null]
  "Message" "text" [not null]
  "FirstDetectedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  "LastDetectedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  "ClosedAt" "timestamp with time zone" [null]
  "ClosedBy" "integer" [null]
  "CloseReason" "text" [null]
  indexes {
    ("AlertID") [pk, name: 'OJTAlerts_pkey']
  }
  Note: 'Cảnh báo đang mở hoặc đã đóng\nCHECK ("Severity" = ANY (ARRAY[\'INFO\'::text, \'WARNING\'::text, \'CRITICAL\'::text]))\nCHECK ("Status" = ANY (ARRAY[\'OPEN\'::text, \'ACKNOWLEDGED\'::text, \'RESOLVED\'::text, \'DISMISSED\'::text]))\nCHECK ("TriggerOutcome" = \'TRIGGERED\'::text)\nCHECK ("LastDetectedAt" >= "FirstDetectedAt")\nCHECK (("Status" = ANY (ARRAY[\'OPEN\'::text, \'ACKNOWLEDGED\'::text])) AND "ClosedAt" IS NULL OR ("Status" = ANY (ARRAY[\'RESOLVED\'::text, \'DISMISSED\'::text])) AND "ClosedAt" IS NOT NULL AND "CloseReason" IS NOT NULL)\nCREATE UNIQUE INDEX "UQ_ActiveOJTAlert" ON public."OJTAlerts" USING btree ("TargetID", "RuleID", "ScopeKey") WHERE ("Status" = ANY (ARRAY[\'OPEN\'::text, \'ACKNOWLEDGED\'::text]))'
}

Table "OJTAlertEvents" {
  "EventID" "bigint" [not null, increment]
  "AlertID" "bigint" [not null]
  "EventType" "text" [not null]
  "ActorUserID" "integer" [null]
  "Note" "text" [null]
  "CreatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("EventID") [pk, name: 'OJTAlertEvents_pkey']
  }
  Note: 'Lịch sử xử lý cảnh báo\nCHECK ("EventType" = ANY (ARRAY[\'CREATED\'::text, \'RECONFIRMED\'::text, \'ACKNOWLEDGED\'::text, \'RESOLVED\'::text, \'DISMISSED\'::text, \'NOTIFICATION_QUEUED\'::text]))'
}

Table "OJTAlertDeliveries" {
  "DeliveryID" "bigint" [not null, increment]
  "AlertID" "bigint" [not null]
  "RecipientUserID" "integer" [not null]
  "Channel" "text" [not null]
  "IdempotencyKey" "text" [not null]
  "NotificationID" "integer" [null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'PENDING\'::text']
  "AttemptCount" "integer" [not null, note: 'PostgreSQL default: 0']
  "NextAttemptAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  "LeaseUntil" "timestamp with time zone" [null]
  "SentAt" "timestamp with time zone" [null]
  "ProviderMessageID" "text" [null]
  "ErrorCode" "text" [null]
  "CreatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("IdempotencyKey") [unique, name: 'OJTAlertDeliveries_IdempotencyKey_key']
    ("NotificationID") [unique, name: 'OJTAlertDeliveries_NotificationID_key']
    ("DeliveryID") [pk, name: 'OJTAlertDeliveries_pkey']
  }
  Note: 'Hàng đợi và kết quả gửi thông báo\nCHECK ("AttemptCount" >= 0)\nCHECK ("Channel" = ANY (ARRAY[\'IN_APP\'::text, \'EMAIL\'::text]))\nCHECK ("Status" = ANY (ARRAY[\'PENDING\'::text, \'SENDING\'::text, \'SENT\'::text, \'FAILED\'::text, \'CANCELLED\'::text]))\nCHECK ("Status" <> \'SENT\'::text OR "SentAt" IS NOT NULL)\nCHECK ("Status" <> \'SENDING\'::text OR "LeaseUntil" IS NOT NULL)'
}

Table "EmbeddingConfigurations" {
  "EmbeddingConfigID" "integer" [not null, increment]
  "Provider" "text" [not null]
  "ModelName" "text" [not null]
  "ModelVersion" "text" [not null]
  "Dimensions" "integer" [not null]
  "PreprocessingVersion" "text" [not null]
  "IsActive" "boolean" [not null, note: 'PostgreSQL default: true']
  indexes {
    ("EmbeddingConfigID", "Dimensions") [unique, name: 'EmbeddingConfigurations_EmbeddingConfigID_Dimensions_key']
    ("Provider", "ModelName", "ModelVersion", "Dimensions", "PreprocessingVersion") [unique, name: 'EmbeddingConfigurations_Provider_ModelName_ModelVersion_Dim_key']
    ("EmbeddingConfigID") [pk, name: 'EmbeddingConfigurations_pkey']
  }
  Note: 'Cấu hình dịch vụ embedding ngoài\nCHECK ("Dimensions" > 0)'
}

Table "MatchingEmbeddings" {
  "EmbeddingID" "bigint" [not null, increment]
  "EmbeddingConfigID" "integer" [not null]
  "Dimensions" "integer" [not null]
  "StudentID" "integer" [null]
  "ProfileID" "bigint" [null]
  "ContentHash" "text" [not null]
  "Embedding" "double precision[]" [not null]
  "CreatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("EmbeddingID", "ProfileID", "EmbeddingConfigID") [unique, name: 'MatchingEmbeddings_EmbeddingID_ProfileID_EmbeddingConfigID_key']
    ("EmbeddingID", "StudentID", "EmbeddingConfigID") [unique, name: 'MatchingEmbeddings_EmbeddingID_StudentID_EmbeddingConfigID_key']
    ("EmbeddingID") [pk, name: 'MatchingEmbeddings_pkey']
  }
  Note: 'Vector và cache theo nội dung, chủ thể, cấu hình\nCHECK (array_position("Embedding", NULL::double precision) IS NULL AND array_position("Embedding", \'NaN\'::double precision) IS NULL AND array_position("Embedding", \'Infinity\'::double precision) IS NULL AND array_position("Embedding", \'-Infinity\'::double precision) IS NULL)\nCHECK ((("StudentID" IS NOT NULL)::integer + ("ProfileID" IS NOT NULL)::integer) = 1)\nCHECK (cardinality("Embedding") = "Dimensions" AND array_ndims("Embedding") = 1 AND array_lower("Embedding", 1) = 1)\nCHECK ("Embedding" <> array_fill(0::double precision, ARRAY["Dimensions"]))\nCREATE UNIQUE INDEX "UQ_ProfileEmbedding" ON public."MatchingEmbeddings" USING btree ("ProfileID", "EmbeddingConfigID", "ContentHash") WHERE ("ProfileID" IS NOT NULL)\nCREATE UNIQUE INDEX "UQ_StudentEmbedding" ON public."MatchingEmbeddings" USING btree ("StudentID", "EmbeddingConfigID", "ContentHash") WHERE ("StudentID" IS NOT NULL)'
}

Table "MatchingRuns" {
  "RunID" "bigint" [not null, increment]
  "IdempotencyKey" "text" [not null]
  "StudentID" "integer" [not null]
  "OJTSemesterID" "integer" [not null]
  "RequestedBy" "integer" [not null]
  "TopK" "smallint" [not null, note: 'PostgreSQL default: 10']
  "FilterVersion" "text" [not null]
  "ScoringVersion" "text" [not null]
  "EmbeddingConfigID" "integer" [not null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'PENDING\'::text']
  "StudentSnapshot" "jsonb" [not null]
  "InputHash" "text" [not null]
  "CreatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  "CompletedAt" "timestamp with time zone" [null]
  "ExpiresAt" "timestamp with time zone" [not null]
  "ErrorCode" "text" [null]
  indexes {
    ("IdempotencyKey") [unique, name: 'MatchingRuns_IdempotencyKey_key']
    ("RunID", "OJTSemesterID") [unique, name: 'MatchingRuns_RunID_OJTSemesterID_key']
    ("RunID", "StudentID", "EmbeddingConfigID") [unique, name: 'MatchingRuns_RunID_StudentID_EmbeddingConfigID_key']
    ("RunID") [pk, name: 'MatchingRuns_pkey']
  }
  Note: 'Lần chạy matching cho một sinh viên và kỳ OJT\nCHECK ("Status" = ANY (ARRAY[\'PENDING\'::text, \'FILTERING\'::text, \'SCORING\'::text, \'SUCCEEDED\'::text, \'FAILED\'::text, \'CANCELLED\'::text]))\nCHECK (jsonb_typeof("StudentSnapshot") = \'object\'::text)\nCHECK ("TopK" >= 1 AND "TopK" <= 100)\nCHECK ("ExpiresAt" > "CreatedAt")\nCHECK (("Status" <> ALL (ARRAY[\'SUCCEEDED\'::text, \'FAILED\'::text, \'CANCELLED\'::text])) OR "CompletedAt" IS NOT NULL)'
}

Table "MatchingCandidates" {
  "RunID" "bigint" [not null]
  "ProfileID" "bigint" [not null]
  "OJTSemesterID" "integer" [not null]
  "Eligibility" "text" [not null]
  "FilterReasons" "jsonb" [not null, note: 'PostgreSQL default: \'[]\'::jsonb']
  "ProfileSnapshot" "jsonb" [not null]
  "CheckedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("RunID", "ProfileID", "Eligibility") [unique, name: 'MatchingCandidates_RunID_ProfileID_Eligibility_key']
    ("RunID", "ProfileID") [pk, name: 'MatchingCandidates_pkey']
  }
  Note: 'Các profile được xét và kết quả lọc trong lần chạy\nCHECK ("Eligibility" = ANY (ARRAY[\'PASS\'::text, \'FAIL\'::text, \'REVIEW_REQUIRED\'::text]))\nCHECK (jsonb_typeof("FilterReasons") = \'array\'::text)\nCHECK (jsonb_typeof("ProfileSnapshot") = \'object\'::text)'
}

Table "MatchingAPICalls" {
  "CallID" "bigint" [not null, increment]
  "RunID" "bigint" [not null]
  "BatchNumber" "integer" [not null]
  "AttemptNumber" "integer" [not null]
  "Provider" "text" [not null]
  "ModelName" "text" [not null]
  "ProviderRequestID" "text" [null]
  "RequestHash" "text" [not null]
  "Status" "text" [not null, note: 'PostgreSQL default: \'PENDING\'::text']
  "HTTPStatus" "integer" [null]
  "ErrorCode" "text" [null]
  "LatencyMs" "integer" [null]
  "InputTokens" "integer" [null]
  "OutputTokens" "integer" [null]
  "StartedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  "FinishedAt" "timestamp with time zone" [null]
  indexes {
    ("CallID", "RunID", "Status") [unique, name: 'MatchingAPICalls_CallID_RunID_Status_key']
    ("RunID", "BatchNumber", "AttemptNumber") [unique, name: 'MatchingAPICalls_RunID_BatchNumber_AttemptNumber_key']
    ("CallID") [pk, name: 'MatchingAPICalls_pkey']
  }
  Note: 'Lịch sử các lần gọi Embedding API\nCHECK ("AttemptNumber" > 0)\nCHECK ("BatchNumber" > 0)\nCHECK ("HTTPStatus" >= 100 AND "HTTPStatus" <= 599)\nCHECK ("InputTokens" >= 0)\nCHECK ("LatencyMs" >= 0)\nCHECK ("OutputTokens" >= 0)\nCHECK ("Status" = ANY (ARRAY[\'PENDING\'::text, \'SUCCEEDED\'::text, \'FAILED\'::text, \'TIMED_OUT\'::text]))\nCHECK ("Status" = \'PENDING\'::text OR "FinishedAt" IS NOT NULL)'
}

Table "MatchingRecommendations" {
  "RecommendationID" "bigint" [not null, increment]
  "RunID" "bigint" [not null]
  "ProfileID" "bigint" [not null]
  "StudentID" "integer" [not null]
  "EmbeddingConfigID" "integer" [not null]
  "Eligibility" "text" [not null, note: 'PostgreSQL default: \'PASS\'::text']
  "CallID" "bigint" [null]
  "CallStatus" "text" [not null, note: 'PostgreSQL default: \'SUCCEEDED\'::text']
  "ScoringSource" "text" [not null]
  "StudentEmbeddingID" "bigint" [not null]
  "ProfileEmbeddingID" "bigint" [not null]
  "CosineSimilarity" "double precision" [not null]
  "MatchScore" "numeric(5,2)" [not null, note: 'Advisory fit score, not probability of hiring or OJT eligibility. Backend computes cosine and versioned scoring; ranks descending with ProfileID tie-break.']
  "Rank" "integer" [not null]
  "Explanation" "text" [not null]
  "MatchedSkills" "jsonb" [not null, note: 'PostgreSQL default: \'[]\'::jsonb']
  "MissingSkills" "jsonb" [not null, note: 'PostgreSQL default: \'[]\'::jsonb']
  "ScoreBreakdown" "jsonb" [not null, note: 'PostgreSQL default: \'{}\'::jsonb']
  indexes {
    ("RunID", "ProfileID") [unique, name: 'MatchingRecommendations_RunID_ProfileID_key']
    ("RunID", "Rank") [unique, name: 'MatchingRecommendations_RunID_Rank_key']
    ("RecommendationID") [pk, name: 'MatchingRecommendations_pkey']
  }
  Note: 'Kết quả phù hợp, điểm, thứ hạng và vector sử dụng\nCHECK ("CallStatus" = \'SUCCEEDED\'::text)\nCHECK ("CosineSimilarity" >= \'-1\'::integer::double precision AND "CosineSimilarity" <= 1::double precision)\nCHECK ("Eligibility" = \'PASS\'::text)\nCHECK ("MatchScore" >= 0::numeric AND "MatchScore" <= 100::numeric)\nCHECK (jsonb_typeof("MatchedSkills") = \'array\'::text)\nCHECK (jsonb_typeof("MissingSkills") = \'array\'::text)\nCHECK ("Rank" > 0)\nCHECK (jsonb_typeof("ScoreBreakdown") = \'object\'::text)\nCHECK ("ScoringSource" = ANY (ARRAY[\'API\'::text, \'CACHE\'::text]))\nCHECK ("ScoringSource" = \'API\'::text AND "CallID" IS NOT NULL OR "ScoringSource" = \'CACHE\'::text AND "CallID" IS NULL)'
}

Table "MatchingRecommendationFeedback" {
  "RecommendationID" "bigint" [not null]
  "Action" "text" [not null]
  "Note" "text" [null]
  "UpdatedAt" "timestamp with time zone" [not null, note: 'PostgreSQL default: now()']
  indexes {
    ("RecommendationID") [pk, name: 'MatchingRecommendationFeedback_pkey']
  }
  Note: 'Phản hồi hiện tại của sinh viên về đề xuất\nCHECK ("Action" = ANY (ARRAY[\'SAVED\'::text, \'DISMISSED\'::text, \'INTERESTED\'::text]))'
}

